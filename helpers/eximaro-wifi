"""Privileged network helper — runs nmcli for the sandboxed app.

The app can't touch the network by design (its service is locked down), so it
drops a small JSON request in the data dir and a root path unit runs this. We read
the request, do the one action it asks for, and write the result back to a file the
app can read. The app never runs nmcli itself.

Only a fixed list of actions is honored, and every value that comes from the
request (an SSID, a password) is handed to nmcli as a separate argument — never
pasted into a shell line — so a request can't smuggle in extra commands.

Actions so far: "scan" (list nearby networks) and "status" (what the radio is
doing). Hosting the setup network and joining a chosen one come next."""

import json
import os
import re
import shutil
import subprocess
import time
from datetime import datetime, timezone
from pathlib import Path

DATA = Path(os.environ.get("DATA_DIR", "/var/lib/eximaro"))
APP_USER = os.environ.get("APP_USER", "eximaro")
REQUEST = DATA / "wifi.request"
SCAN = DATA / "wifi-scan.json"
STATUS = DATA / "wifi-status.json"

NMCLI = shutil.which("nmcli") or "/usr/bin/nmcli"
NFT = shutil.which("nft") or "/usr/sbin/nft"

# Captive-portal redirect: send port 80 on the setup-AP interface to the app on
# 8080, so a joined phone's connectivity probes reach the app and it can bounce
# them to the setup page (which is what makes phones auto-open it). Kept in its OWN
# nftables table so tearing it down is one atomic delete that can never touch
# NetworkManager's masquerade/forward rules — it cannot strand the AP.
CAPTIVE_TABLE = "eximaro_captive"
CAPTIVE_RULESET = """table ip eximaro_captive {
  chain prerouting {
    type nat hook prerouting priority dstnat; policy accept;
    iifname "%s" tcp dport 80 redirect to :8080
  }
}
"""
DEV = "wlan0"  # the Wi-Fi device; found again on every run (see _wifi_device)


def _nft(*args, input_text=None):
    return subprocess.run([NFT, *args], input=input_text,
                          capture_output=True, text=True, timeout=10)


def _captive_on() -> None:
    """Add the :80->:8080 redirect on the AP. Best-effort: if nft is missing or
    fails the AP still works (the on-screen QR/URL is unaffected) — we just lose the
    auto-popup. Delete-then-add so a stale rule left by a crash is reset first."""
    try:
        _nft("delete", "table", "ip", CAPTIVE_TABLE)   # clear any stale copy
    except Exception:
        pass
    try:
        _nft("-f", "-", input_text=CAPTIVE_RULESET % DEV)
    except Exception:
        pass


def _captive_off() -> None:
    """Remove the redirect table. Atomic and self-contained — only ever touches our
    own table, so it can't affect client-mode networking or NetworkManager."""
    try:
        _nft("delete", "table", "ip", CAPTIVE_TABLE)
    except Exception:
        pass


def _now() -> str:
    return datetime.now(timezone.utc).isoformat(timespec="seconds")


def _give_to_app(path: Path) -> None:
    """Hand a result file to the app user, readable only by it."""
    try:
        import pwd  # Unix-only; imported here so the pure parser stays importable anywhere
        info = pwd.getpwnam(APP_USER)
        os.chown(path, info.pw_uid, info.pw_gid)
        os.chmod(path, 0o600)
    except (KeyError, OSError, ModuleNotFoundError):
        pass


def _write(path: Path, obj: dict) -> None:
    tmp = path.with_suffix(path.suffix + ".tmp")
    tmp.write_text(json.dumps(obj))
    tmp.replace(path)
    _give_to_app(path)


def _nmcli(*args, timeout: int = 30) -> subprocess.CompletedProcess:
    return subprocess.run([NMCLI, *args], capture_output=True, text=True, timeout=timeout)


def _scrub(text: str, secret: str) -> str:
    """nmcli's own error text, trimmed for the status file, with the password blanked
    out should nmcli ever echo it back. Blank it BEFORE trimming, so a cut can't leave
    half a password behind."""
    text = (text or "").strip()
    if secret:
        text = text.replace(secret, "***")
    return text[:200]


def _split_terse(line: str) -> list:
    """Split one line of `nmcli -t` output. Terse mode separates fields with ':'
    and escapes any ':' or '\\' inside a value as '\\:' / '\\\\', so a naive split
    would mangle SSIDs that contain a colon."""
    out, cur, i = [], "", 0
    while i < len(line):
        c = line[i]
        if c == "\\" and i + 1 < len(line):
            cur += line[i + 1]
            i += 2
            continue
        if c == ":":
            out.append(cur)
            cur = ""
            i += 1
            continue
        cur += c
        i += 1
    out.append(cur)
    return out


def do_scan(req=None) -> None:
    """List nearby networks, strongest signal first, one entry per SSID."""
    _nmcli("device", "wifi", "rescan", timeout=20)
    res = _nmcli("-t", "-f", "SSID,SIGNAL,SECURITY", "device", "wifi", "list", timeout=20)
    nets, seen = [], set()
    for line in res.stdout.splitlines():
        parts = _split_terse(line)
        if len(parts) < 3:
            continue
        ssid = parts[0]
        if not ssid or ssid in seen:
            continue  # hidden networks have a blank SSID; collapse duplicates
        seen.add(ssid)
        try:
            signal = int(parts[1])
        except ValueError:
            signal = 0
        nets.append({"ssid": ssid, "signal": signal, "secure": parts[2] != ""})
    nets.sort(key=lambda n: n["signal"], reverse=True)
    _write(SCAN, {"networks": nets, "when": _now()})


JOINING = "eximaro-joining"  # the name a join saves its network under until it has worked


def _wifi_profiles() -> list:
    """The saved Wi-Fi networks, as (name, uuid, has it ever connected). Raises if
    nmcli can't say: nothing may be deleted on the strength of a list that wasn't read."""
    res = _nmcli("-t", "-f", "NAME,UUID,TYPE,TIMESTAMP", "connection", "show", timeout=15)
    if res.returncode != 0:
        raise RuntimeError("could not list the saved networks")
    out = []
    for line in res.stdout.splitlines():
        p = _split_terse(line)
        if len(p) >= 4 and p[2] == "802-11-wireless":
            out.append((p[0], p[1], p[3] not in ("", "0")))
    return out


def _ssid_of(uuid: str) -> str:
    res = _nmcli("-g", "802-11-wireless.ssid", "connection", "show", "uuid", uuid, timeout=10)
    lines = res.stdout.splitlines() if res.returncode == 0 else []
    return _split_terse(lines[0])[0] if lines else ""


def _wifi_device() -> str:
    """The Wi-Fi device: wlan0 on a Raspberry Pi, a name like wlp2s0 on other machines."""
    try:
        res = _nmcli("-t", "-f", "DEVICE,TYPE", "device", "status", timeout=10)
        for line in res.stdout.splitlines():
            p = _split_terse(line)
            if len(p) >= 2 and p[1] == "wifi":
                return p[0]
    except subprocess.TimeoutExpired:
        pass
    return "wlan0"


def _has_saved_wifi() -> bool:
    """Is there a real Wi-Fi network already configured to reconnect to (any saved
    wireless profile that isn't our own setup Hotspot, nor a join still under way)? When
    there is, the device must keep trying to rejoin it rather than seize the radio for
    the setup network."""
    try:
        return any(name not in ("Hotspot", JOINING) for name, _, _ in _wifi_profiles())
    except RuntimeError:
        return False


def do_status(req=None) -> None:
    """What the Wi-Fi radio is doing right now: connected/disconnected, to which
    network, whether we're hosting the setup network, and whether a real network is
    already saved (so the watcher knows to reconnect instead of offering setup)."""
    st = {"wifi": None, "ssid": None, "ap_active": False,
          "has_saved": _has_saved_wifi(), "when": _now()}
    res = _nmcli("-t", "-f", "DEVICE,TYPE,STATE,CONNECTION", "device", "status")
    for line in res.stdout.splitlines():
        p = _split_terse(line)
        if len(p) >= 4 and p[1] == "wifi":
            st["wifi"] = p[2]
            if p[3] == "Hotspot":
                st["ap_active"] = True
            elif p[2] == "connected":
                st["ssid"] = p[3]
    _write(STATUS, st)


COUNTRY = os.environ.get("WIFI_COUNTRY", "US")


def _set_country() -> None:
    """A regulatory country must be set before the radio will host an AP. On Pi OS
    raspi-config sets it persistently; ignore failure (already set, or not Pi OS)."""
    try:
        subprocess.run(["raspi-config", "nonint", "do_wifi_country", COUNTRY],
                       capture_output=True, text=True, timeout=15)
    except Exception:
        pass


def do_hotspot(req) -> None:
    """Host the setup network so a phone can join and hand over the real Wi-Fi.
    The app picks the name + password (it also builds the QR from them)."""
    ssid = (req.get("ssid") or "")[:32]
    password = req.get("password") or ""
    if not ssid or len(password) < 8:
        _write(STATUS, {"error": "hotspot needs an ssid and an 8+ char password", "when": _now()})
        return
    _set_country()
    _nmcli("connection", "delete", "Hotspot", timeout=10)  # clear any stale one first
    r = _nmcli("device", "wifi", "hotspot", "ifname", DEV,
               "ssid", ssid, "password", password, "band", "bg", timeout=30)
    ok = r.returncode == 0
    if ok:
        _captive_on()   # turn the setup network into a captive portal
    _write(STATUS, {"ap_active": ok, "ap_ssid": ssid if ok else None,
                    "wifi": "hotspot" if ok else None,
                    "error": None if ok else _scrub(r.stderr, password), "when": _now()})


JOIN_WAIT = 75  # seconds nmcli waits for a join to finish before it gives up
SCAN_WAIT = 25  # seconds a join waits for its network to show up in a scan first
# Settings of its own a saved network can have, carried over when a join replaces it.
CARRIED = ("802-11-wireless.hidden", "ipv4.method", "ipv4.addresses", "ipv4.gateway",
           "ipv4.dns", "ipv6.method")


def _wait_to_see(ssid: str):
    """Wait, up to SCAN_WAIT, for `ssid` to show up in the radio's list of nearby
    networks; says (seen, seen only once asked for by name). nmcli joins only a network
    on that list, and the list is empty right after the setup network goes down, until
    a scan lands - nor is it kept fresh while the radio is connected somewhere else. The
    second half of the wait asks for the network by name as well, which is how one that
    doesn't announce its name (a hidden network) shows up."""
    start = time.monotonic()
    next_scan = 0.0
    while True:
        now = time.monotonic()
        by_name = now - start >= SCAN_WAIT / 2
        if now >= next_scan:
            # Refused when asked too soon after the last one; asking again later is fine.
            _nmcli("device", "wifi", "rescan", "ifname", DEV, *(["ssid", ssid] if by_name else []),
                   timeout=10)
            next_scan = now + 5
        res = _nmcli("-t", "-f", "SSID", "device", "wifi", "list", "ifname", DEV,
                     "--rescan", "no", timeout=10)
        if any(_split_terse(line)[0] == ssid for line in res.stdout.splitlines()):
            return True, by_name
        if time.monotonic() - start >= SCAN_WAIT:
            return False, False
        time.sleep(1)


def _joined(out: str):
    """The profile nmcli says it brought up ("... successfully activated with '<uuid>'")."""
    m = re.search(r"activated with '([0-9a-fA-F-]{36})'", out or "")
    return m.group(1) if m else None


def _carry_over(old: str, new: str) -> None:
    """A saved network's own settings - a fixed address, a hidden name - go over to the
    copy a join made of it, which takes its place."""
    res = _nmcli("-g", ",".join(CARRIED), "connection", "show", "uuid", old, timeout=10)
    values = res.stdout.split("\n") if res.returncode == 0 else []
    if len(values) < len(CARRIED):
        return
    args = []
    for key, value in zip(CARRIED, values):
        value = value.strip().replace("\\:", ":")
        if value and not (key == "802-11-wireless.hidden" and value == "no"):
            args += [key, value]
    if args:
        _nmcli("connection", "modify", "uuid", new, *args, timeout=10)


def _settle(uuid: str, ssid: str) -> None:
    """A join that worked: its network takes the place of any other saved copy of the
    same network (which may hold an old password), keeping that copy's own settings; it
    takes the network's own name; and it is retried forever on reconnect - the default
    gives up after a few tries, which is exactly how a sign that booted before its router
    ends up stranded offline."""
    for name, other, _ in _wifi_profiles():
        if other == uuid or name in ("Hotspot", JOINING) or _ssid_of(other) != ssid:
            continue
        _carry_over(other, uuid)
        _nmcli("connection", "delete", "uuid", other, timeout=10)
    # Never the setup network's name, nor a join's: profiles by those names get removed.
    name = ssid if ssid not in ("Hotspot", JOINING) else f"{ssid} (Wi-Fi)"
    _nmcli("connection", "modify", "uuid", uuid, "connection.id", name,
           "connection.autoconnect", "yes", "connection.autoconnect-retries", "0", timeout=10)


def _drop_joining(keep=None) -> None:
    """Remove what joins saved under JOINING (but `keep`)."""
    for name, uuid, _ in _wifi_profiles():
        if name == JOINING and uuid != keep:
            _nmcli("connection", "delete", "uuid", uuid, timeout=10)


def _tidy_joining() -> None:
    """A join cut off part-way (the power went, say) can leave its network saved under
    JOINING. One that never connected is removed - kept, it would make this screen look
    set up, and it would never offer the setup network again. One that did connect is
    settled, as a join that worked (or left for next time, if its network can't be read
    just now)."""
    try:
        for name, uuid, connected in _wifi_profiles():
            if name != JOINING:
                continue
            if not connected:
                _nmcli("connection", "delete", "uuid", uuid, timeout=10)
                continue
            ssid = _ssid_of(uuid)
            if ssid:
                _settle(uuid, ssid)
    except (RuntimeError, subprocess.TimeoutExpired):
        pass


def do_connect(req) -> None:
    """Join a real network. The radio can't host the AP and join at the same time,
    so drop the AP first; if the join fails, bring the AP back so they can retry.

    The join saves its network under a name of its own (JOINING) until it has worked.
    So a mistyped password never lands in a network already saved - re-entering the
    network a screen is on, with a typo, must not cut it off - and a join that fails
    leaves nothing behind: a saved network makes a screen look set up, and it would
    never offer the setup network again, stranded until someone plugs in a cable."""
    ssid = (req.get("ssid") or "")[:64]
    password = req.get("password") or ""
    if not ssid:
        _write(STATUS, {"error": "no network name given", "when": _now()})
        return
    joined, detail, out = False, "", ""
    try:
        _nmcli("connection", "down", "Hotspot", timeout=15)
        args = ["--wait", str(JOIN_WAIT), "device", "wifi", "connect", ssid, "ifname", DEV,
                "name", JOINING]
        if password:
            args += ["password", password]
        seen, by_name = _wait_to_see(ssid)
        # Found only when asked for by name - or not at all: it may just not announce
        # its name, and is joined (and saved) as a hidden network.
        if by_name or not seen:
            args += ["hidden", "yes"]
        # nmcli gives up by itself after JOIN_WAIT; the margin is so that nmcli, not
        # this helper, is the one to stop a slow join.
        r = _nmcli(*args, timeout=JOIN_WAIT + 15)
        joined, detail, out = r.returncode == 0, _scrub(r.stderr, password), r.stdout
    except subprocess.TimeoutExpired:
        detail = "the network took too long to answer"
    except Exception as exc:   # whatever went wrong, the setup network must come back
        detail = f"the network helper failed ({type(exc).__name__})"
    if joined:
        try:
            # The network this join brought up - and only it: anything an earlier join
            # left under the same name is removed, never settled in its place.
            mine = _joined(out) or next((u for n, u, c in _wifi_profiles() if n == JOINING and c), None)
            _drop_joining(keep=mine)
            if mine:
                _settle(mine, ssid)
        except (RuntimeError, subprocess.TimeoutExpired):
            pass                  # the next run of this helper settles it (_tidy_joining)
        _nmcli("connection", "delete", "Hotspot", timeout=10)  # don't let the AP come back
        _captive_off()   # clean client mode — no redirect left behind
        do_status(req)
    else:
        try:
            _drop_joining()
        except (RuntimeError, subprocess.TimeoutExpired):
            pass                  # the next run of this helper removes it (_tidy_joining)
        try:
            back = _nmcli("connection", "up", "Hotspot", timeout=20).returncode == 0
        except subprocess.TimeoutExpired:
            back = False
        if back:
            _captive_on()    # re-arm the portal so a retry still auto-opens
        _write(STATUS, {"error": f"could not join {ssid}", "detail": detail,
                        "ap_active": back, "when": _now()})


def do_stop(req) -> None:
    """Take down the setup network."""
    _nmcli("connection", "down", "Hotspot", timeout=15)
    _nmcli("connection", "delete", "Hotspot", timeout=10)
    _captive_off()
    _write(STATUS, {"ap_active": False, "when": _now()})


ACTIONS = {"scan": do_scan, "status": do_status,
           "hotspot": do_hotspot, "connect": do_connect, "stop": do_stop}


def main() -> None:
    try:
        req = json.loads(REQUEST.read_text())
    except (json.JSONDecodeError, OSError):
        req = {}
    finally:
        try:
            REQUEST.unlink()
        except OSError:
            pass
    fn = ACTIONS.get(req.get("action"))
    if not fn:
        return
    # Never record an exception's own text: a timed-out join's message is the whole
    # nmcli command line, Wi-Fi password included. Say what kind of failure it was.
    try:
        global DEV
        DEV = _wifi_device()
        _tidy_joining()   # only one helper runs at a time: any JOINING network is a leftover
        fn(req)
    except subprocess.TimeoutExpired:
        _write(STATUS, {"error": "the network took too long to answer",
                        "action": req.get("action"), "when": _now()})
    except Exception as exc:  # never leave the request stuck; report and move on
        _write(STATUS, {"error": f"the network helper failed ({type(exc).__name__})",
                        "action": req.get("action"), "when": _now()})


if __name__ == "__main__":
    main()
