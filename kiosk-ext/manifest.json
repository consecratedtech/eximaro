{
  "manifest_version": 3,
  "name": "eximaro screen",
  "version": "1.0",
  "description": "Tells the eximaro screen what Google sent into a deck's frame: the deck, or its own error page.",
  "content_scripts": [
    {
      "matches": ["http://localhost/screen*"],
      "run_at": "document_start",
      "js": ["screen.js"]
    },
    {
      "matches": ["https://docs.google.com/presentation/*"],
      "all_frames": true,
      "run_at": "document_end",
      "js": ["deck.js"]
    }
  ]
}
